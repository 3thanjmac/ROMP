{
	"//": "background_color and theme_color are literal copies of the dark --bg token in src/styles/tokens.css: oklch(0.16 0.008 255)",
	"name": "ROMP",
	"short_name": "ROMP",
	"description": "Remote coding shell for OMP agents",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"orientation": "any",
	"background_color": "#0b0d11",
	"theme_color": "#0b0d11",
	"icons": [
		{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
		{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
	]
}
