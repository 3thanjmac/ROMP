[Unit]
Description=Pull and apply ROMP updates
After=network-online.target
Wants=network-online.target
# The Update button starts it through romp-update.path; a few quick presses must not trip the start limit, which
# would leave the path unit failed and the button doing nothing.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/romp-update
# install.sh rebuilds the web app and may install packages.
TimeoutStartSec=30min
