#!/usr/bin/env bash
# Serves ROMP on the VM's LAN address too, for devices that are not running Tailscale. Caddy answers on the
# same ports and hostname as `tailscale serve` (<vm>.<tailnet>.ts.net), with the certificate from
# `tailscale cert`, so a local DNS record pointing that name at the LAN address makes the same URL work.
# LAN visitors sign in with the password each person sets with `romp-gateway passwd`.
#
#   sudo romp-lan enable [<lan-ip>]   install Caddy and start serving (detects the address if omitted)
#   sudo romp-lan sync                follow `tailscale serve` and renew the certificate (daily timer,
#                                     install.sh and add-user.sh run it)
#   sudo romp-lan disable             stop serving on the LAN
set -euo pipefail

ROMP_SRC="${ROMP_SRC:-/opt/romp}"
CONF=/etc/romp/lan.env
TLS_DIR=/etc/romp/tls
CADDYFILE=/etc/caddy/Caddyfile
MARKER="# Generated by romp-lan"
PROXY_USER=caddy

die() { echo "romp-lan: $*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "must run as root"

detect_ip() {
	ip -4 route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }'
}

tailnet_host() {
	tailscale status --json | bun -e '
		const status = JSON.parse(await Bun.stdin.text());
		console.log((status.Self?.DNSName ?? "").replace(/\.$/, ""));'
}

# One "<https-port> <gateway-port>" line per `tailscale serve --https=<port> http://127.0.0.1:<port>`.
serve_routes() {
	tailscale serve status --json | bun -e '
		const text = await Bun.stdin.text();
		const config = text.trim() ? JSON.parse(text) : {};
		for (const [hostPort, site] of Object.entries(config.Web ?? {})) {
			const target = /^http:\/\/127\.0\.0\.1:(\d+)\/?$/.exec(site?.Handlers?.["/"]?.Proxy ?? "");
			if (target) console.log(`${hostPort.split(":").pop()} ${target[1]}`);
		}'
}

restart_gateway() {
	local user="$1"
	runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$(id -u "$user")" \
		systemctl --user restart romp-gateway.service || echo "  could not restart $user's gateway" >&2
}

# Gateway configs of every ROMP user.
gateway_configs() {
	local member home
	for member in $(getent group romp | cut -d: -f4 | tr ',' ' '); do
		home="$(getent passwd "$member" | cut -d: -f6)"
		[[ -f "$home/.config/romp/gateway.toml" ]] && echo "$member $home/.config/romp/gateway.toml"
	done
	return 0
}

lan_sync() {
	[[ -f $CONF ]] || die "LAN access is off; turn it on with: sudo romp-lan enable"
	# shellcheck source=/dev/null
	source "$CONF"
	local host
	host="$(tailnet_host)"
	[[ -n $host ]] || die "tailscale is not logged in"
	local routes
	mapfile -t routes < <(serve_routes)
	((${#routes[@]} > 0)) || die "tailscale serve has no gateways yet; run add-user.sh first"

	# `tailscale cert` reuses the cached certificate until it is close to expiring.
	install -d -m 0750 -o root -g "$PROXY_USER" "$TLS_DIR"
	local cert="$TLS_DIR/$host.crt" key="$TLS_DIR/$host.key" before after
	# No certificate yet on the first run: hash nothing rather than let pipefail end the script silently.
	before="$({ cat "$cert" "$key" 2>/dev/null || true; } | sha256sum)"
	tailscale cert --cert-file "$cert" --key-file "$key" "$host" >/dev/null 2>&1 ||
		die "tailscale cert failed; HTTPS must be enabled for the tailnet (it is for tailscale serve)"
	chown "root:$PROXY_USER" "$cert" "$key"
	chmod 0644 "$cert"
	chmod 0640 "$key"
	after="$(cat "$cert" "$key" | sha256sum)"

	local next route https_port gateway_port
	next="$(mktemp)"
	{
		echo "$MARKER from \`tailscale serve status\`; changes here are overwritten."
		echo "{"
		echo "	auto_https disable_redirects"
		echo "}"
		for route in "${routes[@]}"; do
			read -r https_port gateway_port <<<"$route"
			cat <<EOF

https://$host:$https_port {
	bind $LAN_IP
	tls $cert $key
	reverse_proxy 127.0.0.1:$gateway_port {
		header_up -Tailscale-User-Login
		header_up -Tailscale-User-Name
		header_up -Tailscale-User-Profile-Pic
	}
}
EOF
		done
	} >"$next"
	caddy validate --adapter caddyfile --config "$next" >/dev/null 2>&1 || {
		caddy validate --adapter caddyfile --config "$next" >&2 || true
		rm -f "$next"
		die "generated Caddy config is invalid"
	}
	local changed=false
	if ! cmp -s "$next" "$CADDYFILE"; then
		if [[ -f $CADDYFILE ]] && ! grep -q "^$MARKER" "$CADDYFILE"; then
			cp "$CADDYFILE" "$CADDYFILE.before-romp"
			echo "previous $CADDYFILE saved as $CADDYFILE.before-romp"
		fi
		install -m 0644 "$next" "$CADDYFILE"
		changed=true
	fi
	rm -f "$next"
	[[ $before == "$after" ]] || changed=true

	# Connections from Caddy carry no Tailscale identity; this tells each gateway to ask for a password.
	local user config
	while read -r user config; do
		grep -q '^lan_proxy_user' "$config" && continue
		[[ -z $(tail -c 1 "$config") ]] || echo >>"$config"
		echo "lan_proxy_user = \"$PROXY_USER\"" >>"$config"
		echo "$user: gateway now accepts LAN sign-ins (restarting it)"
		restart_gateway "$user"
	done < <(gateway_configs)

	systemctl enable --quiet caddy
	if $changed || ! systemctl is-active --quiet caddy; then systemctl restart caddy; fi
	for route in "${routes[@]}"; do
		read -r https_port _ <<<"$route"
		echo "LAN: https://$host$([[ $https_port == 443 ]] || echo ":$https_port")/ on $LAN_IP"
	done
}

enable() {
	command -v tailscale >/dev/null || die "tailscale is not installed"
	local lan_ip="${1:-$(detect_ip)}"
	[[ $lan_ip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "could not find the LAN address; pass it: sudo romp-lan enable 192.168.1.50"
	ip -4 -o addr show | grep -q " inet $lan_ip/" || die "$lan_ip is not an address of this machine"
	[[ $lan_ip == 100.* ]] && die "$lan_ip looks like a Tailscale address; pass the LAN address: sudo romp-lan enable <lan-ip>"

	export DEBIAN_FRONTEND=noninteractive
	command -v caddy >/dev/null || apt-get install -y -qq caddy >/dev/null
	install -d -m 0755 /etc/romp
	echo "LAN_IP=$lan_ip" >"$CONF"
	lan_sync
	install -m 0644 "$ROMP_SRC/deploy/systemd/romp-lan.service" /etc/systemd/system/romp-lan.service
	install -m 0644 "$ROMP_SRC/deploy/systemd/romp-lan.timer" /etc/systemd/system/romp-lan.timer
	systemctl daemon-reload
	systemctl enable --now --quiet romp-lan.timer

	cat <<EOF

LAN access is on. Two steps remain:
  1. In your router's (or Pi-hole's) local DNS, point $(tailnet_host) at $lan_ip.
     Give the VM a fixed address (a DHCP reservation) so the record stays right.
  2. Each person sets the password they will sign in with on the LAN:
       romp-gateway passwd                (as themselves, e.g. in a ROMP terminal)
       sudo -iu <user> romp-gateway passwd
EOF
}

disable() {
	systemctl disable --now --quiet romp-lan.timer 2>/dev/null || true
	systemctl disable --now --quiet caddy 2>/dev/null || true
	rm -f "$CONF"
	local user config
	while read -r user config; do
		grep -q '^lan_proxy_user' "$config" || continue
		sed -i '/^lan_proxy_user[[:space:]]*=/d' "$config"
		echo "$user: gateway no longer accepts LAN sign-ins (restarting it)"
		restart_gateway "$user"
	done < <(gateway_configs)
	echo "LAN access is off. Remove the local DNS record for $(tailnet_host) so devices use Tailscale again."
}

case "${1:-}" in
	enable) shift; enable "$@" ;;
	sync) lan_sync ;;
	disable) disable ;;
	*) sed -n '2,11p' "$0" >&2; exit 1 ;;
esac
